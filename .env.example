# Application
APP_NAME=Financial Agentic RAG
HOST=0.0.0.0
PORT=8001
FINANCIAL_DATA_DIR=financial_data
STATIC_DIR=static
LOG_FILE=logs/app.log

# Comma-separated browser origins for the WebSocket/API server. Do not use *
# when credentials are enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# LLM
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
LLM_MODEL=

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=financial
MILVUS_COLLECTION=financial_rag_v1

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=financial_qa
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_FAQ_TABLE=financial_faq
MYSQL_CONVERSATION_TABLE=financial_conversations

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_KEY_PREFIX=financial:

# Models
BGE_M3_MODEL_PATH=
RERANKER_MODEL_PATH=
BERT_ROUTER_MODEL_PATH=
BERT_BASE_MODEL_PATH=
DOCUMENT_SEGMENTATION_MODEL_PATH=

# Retrieval (deployment override; takes precedence over config.ini)
RETRIEVAL_K=30
CANDIDATE_M=3
# Dedicated Redis Stack instance for LangGraph Agent session checkpoints.
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6380
AGENT_REDIS_DB=0
AGENT_REDIS_PREFIX=financial:agent:
# News MCP defaults to domestic public sources. Set domestic_google to enable
# Google News only after domestic fallbacks; google is for non-mainland use.
NEWS_PROVIDER_MODE=domestic
NEWS_PROVIDER_TIMEOUT_SECONDS=3
